# Copy to raise_ros2_ws/src/.env and fill in the key you have.
#
#   cp .env.example raise_ros2_ws/src/.env
#
# Every new terminal loads that file (setup/aliases.sh does it). The real .env
# is gitignored — never commit a key, and never paste one into a source file.
#
# Modules 0 and 1 need neither of these: the robot, its skills and all of ROS 2
# run entirely on your machine. From module 2 on, the agent lessons call an LLM,
# and each script says at the top which provider it uses.

OPENAI_API_KEY=
GEMINI_API_KEY=
